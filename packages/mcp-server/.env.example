# Cloud Mail MCP Server Configuration
# Base URL of your Cloud Mail deployment
CLOUD_MAIL_API_URL=https://mail.jcllyuki.com

# Public API Token obtained from POST /api/public/genToken
CLOUD_MAIL_TOKEN=your_public_token_here

# Operating mode:
# - "readonly": Hard blocks send/delete/create locally
# - "ask" (default, recommended): Prompts user for approval on write operations via MCP Host
# - "full": Allows write operations to execute directly
CLOUD_MAIL_MODE=ask
